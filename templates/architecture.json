{
  "version": 1,
  "components": [
    {
      "name": "api",
      "paths": ["src/api/**"],
      "referenceMarkers": ["@app/api/"],
      "allowedDependencies": ["domain", "shared"]
    },
    {
      "name": "domain",
      "paths": ["src/domain/**"],
      "referenceMarkers": ["@app/domain/"],
      "allowedDependencies": ["shared"]
    },
    {
      "name": "adapters",
      "paths": ["src/adapters/**"],
      "referenceMarkers": ["@app/adapters/"],
      "allowedDependencies": ["domain", "shared"]
    },
    {
      "name": "shared",
      "paths": ["src/shared/**"],
      "referenceMarkers": ["@app/shared/"],
      "allowedDependencies": []
    }
  ],
  "resourceRules": [
    {
      "id": "secret-adapter-only",
      "referenceMarkers": ["process.env.", "Deno.env.", "os.Getenv("],
      "allowedComponents": ["adapters"]
    }
  ],
  "combinationRules": [
    {
      "id": "secret-to-external-output",
      "sourceMarkers": ["process.env.", "Deno.env.", "os.Getenv("],
      "sinkMarkers": ["fetch(", "axios.", "http.request(", "webhook"],
      "scope": "repository",
      "components": ["api", "domain", "adapters", "shared"]
    }
  ],
  "criticalPaths": [
    {
      "id": "authentication",
      "paths": ["src/api/auth/**", "src/domain/auth/**"]
    },
    {
      "id": "tenant-ownership",
      "paths": ["src/api/tenant/**", "src/domain/tenant/**"]
    },
    {
      "id": "core-write-integrity",
      "paths": ["src/domain/**/commands/**", "src/domain/**/write/**", "src/adapters/database/**", "migrations/**"]
    },
    {
      "id": "deployment-exposure",
      "paths": ["infra/**", "deploy/**", "Dockerfile", "docker-compose*.yml", ".github/workflows/deploy*.yml"]
    },
    {
      "id": "architecture-policy",
      "paths": [".pr-security-gate/architecture.json", ".pr-security-gate/debt.json"]
    }
  ],
  "debtBudgets": {
    "mode": "ratchet",
    "total": 20,
    "maxAgeDays": 90,
    "components": {
      "api": 5,
      "domain": 5,
      "adapters": 5,
      "shared": 5
    }
  }
}
